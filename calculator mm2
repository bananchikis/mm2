------------------------------------------------------------
-- HTTP
------------------------------------------------------------

local function getRequest()

    if syn and syn.request then
        return syn.request
    end

    if http and http.request then
        return http.request
    end

    if request then
        return request
    end

    if http_request then
        return http_request
    end

    if fluxus and fluxus.request then
        return fluxus.request
    end

    return nil
end

local REQUEST = getRequest()

if not REQUEST then
    warnlog("HTTP REQUEST FUNCTION NOT FOUND")
    return
end

local function download(url)

    local ok, result = pcall(function()
        return REQUEST({
            Url = url,
            Method = "GET"
        })
    end)

    if not ok then
        return nil, tostring(result)
    end

    if type(result) ~= "table" then
        return nil, "invalid response"
    end

    if not result.Body then
        return nil, "empty body"
    end

    return result.Body
end

------------------------------------------------------------
-- SUPREME VALUES
------------------------------------------------------------

local URLs = {
    Godlies = "https://supremevalues.com/mm2/godlies",
    Chromas = "https://www.supremevalues.com/mm2/chromas.php",
    Ancients = "https://supremevalues.com/mm2/ancients",
    Uniques = "https://supremevalues.com/mm2/uniques",
    Pets = "https://supremevalues.com/mm2/pets"
}

local Values = {
    Godlies = {},
    Chromas = {},
    Ancients = {},
    Uniques = {},
    Pets = {}
}

local function normalizeName(s)

    if not s then
        return ""
    end

    s = tostring(s)

    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    s = s:gsub("%s+", " ")

    return s
end

local function lower(s)
    return string.lower(normalizeName(s))
end

local function htmlToText(html)

    html = html:gsub("<script.-</script>", " ")
    html = html:gsub("<style.-</style>", " ")

    html = html:gsub("<br%s*/?>", "\n")
    html = html:gsub("</p>", "\n")
    html = html:gsub("</div>", "\n")
    html = html:gsub("</tr>", "\n")

    html = html:gsub("<.->", " ")

    html = html:gsub("&nbsp;", " ")
    html = html:gsub("&amp;", "&")
    html = html:gsub("&quot;", '"')
    html = html:gsub("&#39;", "'")
    html = html:gsub("&#x27;", "'")
    html = html:gsub("&#8217;", "'")
    html = html:gsub("&#8242;", "'")

    return html
end

local function parsePage(body, category)

    if not body then
        return 0
    end

    local text = htmlToText(body)

    local count = 0

    for name, value in text:gmatch(
        "([%a%d][%a%d%s%-%'%%.%&%(%)]-)%s+Value%s*%-%s*([%d,]+)"
    ) do

        name = normalizeName(name)

        value = tostring(value):gsub(",", "")
        value = tonumber(value)

        if name ~= "" and value then
            Values[category][name] = value
            count += 1
        end
    end

    --------------------------------------------------------
    -- Fallback parser
    --------------------------------------------------------

    if count == 0 then

        for name, value in text:gmatch(
            "([%a%d][%a%d%s%-%'%%.%&%(%)]-)%s*Value[^%d]*([%d,]+)"
        ) do

            name = normalizeName(name)

            value = tostring(value):gsub(",", "")
            value = tonumber(value)

            if name ~= "" and value then
                Values[category][name] = value
                count += 1
            end
        end
    end

    return count
end

