    local function refresh()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("TextLabel") or c:IsA("TextButton") then
                c:Destroy()
            end
        end

        for i, item in ipairs(inventory) do
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundTransparency = 1
            row.Text = ("%s   -   %d   [X]"):format(item.name, item.price)
            row.TextColor3 = Color3.fromRGB(230, 230, 230)
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.Font = Enum.Font.Gotham
            row.TextSize = 13
            row.LayoutOrder = i
            row.Parent = scroll

            row.MouseButton1Click:Connect(function()
                removeItem(i)
                refresh()
            end)
        end

        total.Text = "Total: " .. getTotal()
    end

    addBtn.MouseButton1Click:Connect(function()
        local text = input.Text
        if #text < 2 then
            status.Text = "Введи название предмета"
            status.TextColor3 = Color3.fromRGB(255, 180, 100)
            return
        end
        local ok, err = addItem(text)
        if ok then
            status.Text = "Добавлено: " .. text
            status.TextColor3 = Color3.fromRGB(120, 255, 140)
            input.Text = ""
            refresh()
        else
            status.Text = err
            status.TextColor3 = Color3.fromRGB(255, 120, 120)
        end
    end)

    clearBtn.MouseButton1Click:Connect(function()
        inventory = {}
        refresh()
        status.Text = "Очищено"
        status.TextColor3 = Color3.fromRGB(180, 180, 180)
    end)

