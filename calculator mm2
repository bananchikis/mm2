local function getTexts(obj)

    local result = {}

    if not obj then
        return result
    end

    if obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox") then

        if obj.Text
            and obj.Text ~= "" then

            table.insert(
                result,
                normalizeName(obj.Text)
            )
        end
    end

    for _, child in ipairs(
        obj:GetDescendants()
    ) do

        if child:IsA("TextLabel")
            or child:IsA("TextButton")
            or child:IsA("TextBox") then

            if child.Text
                and child.Text ~= "" then

                table.insert(
                    result,
                    normalizeName(child.Text)
                )
            end
        end
    end

    return result
end

------------------------------------------------------------
-- QUANTITY
------------------------------------------------------------

local function parseQuantity(text)

    if not text then
        return nil
    end

    text =
        normalizeName(text)

    local n =
        text:match("^x(%d+)$")

    if n then
        return tonumber(n)
    end

    n =
        text:match("^(%d+)x$")

    if n then
        return tonumber(n)
    end

    n =
        text:match(
            "[Qq][Tt][Yy]%s*[:%-]?%s*(%d+)"
        )

    if n then
        return tonumber(n)
    end

    n =
        text:match(
            "[Qq]uantity%s*[:%-]?%s*(%d+)"
        )

    if n then
        return tonumber(n)
    end

    return nil
end

local function getQuantity(card)

    if not card then
        return 1
    end

    for _, text in ipairs(
        getTexts(card)
    ) do

        local q =
            parseQuantity(text)

        if q then
            return q
        end
    end

    return 1
end

------------------------------------------------------------
-- RARITY
------------------------------------------------------------

local function normalizeRarity(s)

    if not s then
        return nil
    end

    s = lower(s)

    --------------------------------------------------------
    -- Uncommon MUST be checked before Common
    --------------------------------------------------------

    if s:find("uncommon") then
        return "uncommon"
    end

    if s:find("godly") then
        return "godly"
    end

    if s:find("ancient") then
        return "ancient"
    end

    if s:find("unique") then
        return "unique"
    end

    if s:find("chroma") then
        return "chroma"
    end

    if s:find("legendary") then
        return "legendary"
    end

    if s:find("vintage") then
        return "vintage"
    end

    if s:find("rare") then
        return "rare"
    end

    if s == "common"
        or s:find("common") then

        return "common"
    end

    return nil
end

local INVALID_RARITIES = {
    common = true,
    uncommon = true,
    rare = true,
    legendary = true,
    vintage = true
}

------------------------------------------------------------
-- SYNC RARITY
------------------------------------------------------------

local function metadataRarity(data)

    if not data then
        return nil
    end

    local rarity =
        data.Rarity
        or data.ItemRarity
        or data.RarityName

    return normalizeRarity(rarity)
end

local function syncItemName(data)

    if not data then
        return nil
    end

    return normalizeName(
        data.ItemName
        or data.Name
        or data.DisplayName
    )
end

------------------------------------------------------------
-- CARD RARITY
------------------------------------------------------------

local function getCardRarity(card)

    if not card then
        return nil
    end

    --------------------------------------------------------
    -- Card attributes
    --------------------------------------------------------

    for attributeName, value in pairs(
        card:GetAttributes()
    ) do

        local attr =
            lower(attributeName)

        if attr:find("rarity")
            or attr:find("tier") then

            if type(value) == "string" then

                local rarity =
                    normalizeRarity(value)

                if rarity then
                    return rarity
                end
            end
        end
    end

    --------------------------------------------------------
    -- Descendant attributes
    --------------------------------------------------------

    for _, obj in ipairs(
        card:GetDescendants()
    ) do

        for attributeName, value in pairs(
            obj:GetAttributes()
        ) do

            local attr =
                lower(attributeName)

            if attr:find("rarity")
                or attr:find("tier") then

                if type(value) == "string" then

                    local rarity =
                        normalizeRarity(value)

                    if rarity then
                        return rarity
                    end
                end
            end
        end
    end

    --------------------------------------------------------
    -- Text
    --------------------------------------------------------

    for _, text in ipairs(
        getTexts(card)
    ) do

        local rarity =
            normalizeRarity(text)

        if rarity then
            return rarity
        end
    end

    return nil
end

------------------------------------------------------------
-- CARD DETECTION
------------------------------------------------------------

local function looksLikeCard(obj)

    if not obj
        or not obj:IsA("GuiObject") then

        return false
    end

    local imageCount = 0
    local textCount = 0

    for _, child in ipairs(
        obj:GetDescendants()
    ) do

        if child:IsA("ImageLabel")
            or child:IsA("ImageButton") then

            imageCount += 1
        end

        if child:IsA("TextLabel")
            or child:IsA("TextButton")
            or child:IsA("TextBox") then

            textCount += 1
        end
    end

    return imageCount > 0
        or textCount > 0
end

local function findCard(
    textObject,
    root
)

    if not textObject then
        return nil
    end

    local current =
        textObject

    local best = nil

    for i = 1, 9 do

        if not current then
            break
        end

        if current == root then
            break
        end

        if current:IsA("GuiObject")
            and looksLikeCard(current) then

            local count =
                #current:GetDescendants()

            if count < 120 then
                best = current
            end
        end

        current =
            current.Parent
    end

    return best
end

------------------------------------------------------------
-- SUPREME VALUE LOOKUP
------------------------------------------------------------

local function findValue(
    category,
    itemName
)

    if not category
        or not itemName then

        return nil, nil
    end

    local values =
        Values[category]

    if not values then
        return nil, nil
    end

    itemName =
        normalizeName(itemName)

    --------------------------------------------------------
    -- Exact
    --------------------------------------------------------

    if values[itemName] then
        return values[itemName], itemName
    end

    --------------------------------------------------------
    -- Case insensitive
    --------------------------------------------------------

    local target =
        lower(itemName)

    for name, value in pairs(
        values
    ) do

        if lower(name) == target then
            return value, name
        end
    end

    --------------------------------------------------------
    -- Chroma without prefix
    --------------------------------------------------------

    if category == "Chromas" then

        local noPrefix =
            itemName:gsub(
                "^[Cc]hroma%s+",
                ""
            )

        local target2 =
            lower(noPrefix)

        for name, value in pairs(
            values
        ) do

            local clean =
                normalizeName(name)

            clean =
                clean:gsub(
                    "^[Cc]hroma%s+",
                    ""
                )

            if lower(clean) == target2 then
                return value, name
            end
        end
    end

    return nil, nil
end

------------------------------------------------------------
-- CATEGORY
------------------------------------------------------------

local function categoryFor(
    data,
    card
)

    if not data then
        return nil, nil
    end

    local syncRarity =
        metadataRarity(data)

    local cardRarity =
        getCardRarity(card)

    --------------------------------------------------------
    -- GUI explicitly says lower rarity:
    -- NEVER count it.
    --------------------------------------------------------

    if cardRarity
        and INVALID_RARITIES[cardRarity] then

        return nil, nil
    end

    --------------------------------------------------------
    -- If card explicitly says valid rarity,
    -- trust the card.
    --------------------------------------------------------

    if cardRarity == "godly" then

        return "Godlies",
            syncItemName(data)

    elseif cardRarity == "ancient" then

        return "Ancients",
            syncItemName(data)

    elseif cardRarity == "unique" then

        return "Uniques",
            syncItemName(data)

    elseif cardRarity == "chroma" then

        local name =
            syncItemName(data)

        if lower(name):sub(1, 7) ~= "chroma " then
            name =
                "Chroma " .. name
        end

        return "Chromas", name
    end

    --------------------------------------------------------
    -- Otherwise use Sync rarity.
    --------------------------------------------------------

    if syncRarity == "godly" then

        return "Godlies",
            syncItemName(data)

    elseif syncRarity == "ancient" then

        return "Ancients",
            syncItemName(data)

    elseif syncRarity == "unique" then

        return "Uniques",
            syncItemName(data)

    elseif syncRarity == "chroma" then

        local name =
            syncItemName(data)

        if lower(name):sub(1, 7) ~= "chroma " then
            name =
                "Chroma " .. name
        end

        return "Chromas", name
    end

    return nil, nil
end

------------------------------------------------------------
-- SYNC CANDIDATES
------------------------------------------------------------

local function findCandidates(name)

    return SyncByName[
        lower(name)
    ]
end

------------------------------------------------------------
-- RESOLVE ITEM
------------------------------------------------------------

local function resolveText(
    textObject,
    card
)

    local text =
        normalizeName(
            textObject.Text
        )

    if text == "" then
        return nil
    end

    local candidates =
        findCandidates(text)

    if not candidates then
        return nil
    end

    --------------------------------------------------------
    -- 1. Try rarity from the actual card.
    --------------------------------------------------------

    local cardRarity =
        getCardRarity(card)

    if cardRarity then

        ----------------------------------------------------
        -- Never accept lower rarities.
        ----------------------------------------------------

        if INVALID_RARITIES[cardRarity] then
            return nil
        end

        for _, candidate in ipairs(
            candidates
        ) do

            local data =
                candidate.Data

            local rarity =
                metadataRarity(data)

            if rarity == cardRarity then

                local category,
                    itemName =
                    categoryFor(
                        data,
                        card
                    )

                if category
                    and itemName then

                    return category,
                        itemName,
                        data
                end
            end
        end
    end

    --------------------------------------------------------
    -- 2. Only one candidate.
    --------------------------------------------------------

    if #candidates == 1 then

        local data =
            candidates[1].Data

        local category,
            itemName =
            categoryFor(
                data,
                card
            )

        if category
            and itemName then

            return category,
                itemName,
                data
        end

        return nil
    end

    --------------------------------------------------------
    -- 3. Multiple candidates.
    --
    -- Pick the ONLY valuable rarity.
    --------------------------------------------------------

    local valuable = nil
    local valuableCount = 0

    for _, candidate in ipairs(
        candidates
    ) do

        local data =
            candidate.Data

        local rarity =
            metadataRarity(data)

        if rarity == "godly"
            or rarity == "ancient"
            or rarity == "unique"
            or rarity == "chroma" then

            valuable = data
            valuableCount += 1
        end
    end

    --------------------------------------------------------
    -- Exactly one valuable candidate.
    --------------------------------------------------------

    if valuableCount == 1
        and valuable then

        local category,
            itemName =
            categoryFor(
                valuable,
                card
            )

        if category
            and itemName then

            if DEBUG then

                log(
                    "AMBIGUOUS RESOLVED: " ..
                    text ..
                    " -> " ..
                    tostring(category) ..
                    " / " ..
                    tostring(itemName) ..
                    " [" ..
                    tostring(
                        metadataRarity(
                            valuable
                        )
                    ) ..
                    "]"
                )
            end

            return category,
                itemName,
                valuable
        end
    end

    --------------------------------------------------------
    -- 4. Multiple valuable candidates:
    -- don't guess.
    --------------------------------------------------------

    if DEBUG then

        local list = {}

        for _, candidate in ipairs(
            candidates
        ) do

            local data =
                candidate.Data

            table.insert(
                list,
                tostring(
                    syncItemName(data)
                ) ..
                " [" ..
                tostring(
                    metadataRarity(data)
                ) ..
                "]"
            )
        end

        log(
            "AMBIGUOUS ITEM IGNORED: " ..
            text ..
            " -> " ..
            table.concat(
                list,
                ", "
            )
        )
    end

    return nil
end

------------------------------------------------------------
-- RESULTS
------------------------------------------------------------

local Results = {
    Godlies = {},
    Chromas = {},
    Ancients = {},
    Uniques = {},
    Pets = {}
}

local SeenCards = {}

local function addResult(
    category,
    itemName,
    quantity,
    value,
    card
)

    if not category
        or not itemName
        or not value then

        return
    end

    quantity =
        tonumber(quantity) or 1

    --------------------------------------------------------
    -- Prevent same GUI card from being counted
    -- multiple times because it has multiple TextLabels.
    --------------------------------------------------------

    if card then

        if SeenCards[card] then
            return
        end

        SeenCards[card] = true
    end

    if not Results[category][itemName] then

        Results[category][itemName] = {
            Quantity = 0,
            Value = value
        }
    end

    Results[category][itemName].Quantity +=
        quantity
end

------------------------------------------------------------
-- SCAN WEAPONS
------------------------------------------------------------

local function scanWeapons()

    if not Weapons then
        return
    end

    log("------------------------------------------")
    log("SCANNING ALL WEAPONS")
    log("------------------------------------------")

    local objects =
        Weapons:GetDescendants()

    log(
        "WEAPON GUI OBJECTS: " ..
        tostring(#objects)
    )

    local labelsFound = 0
    local matched = 0

    for _, obj in ipairs(objects) do

        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox") then

            local text =
                normalizeName(obj.Text)

            if text ~= "" then

                local candidates =
                    findCandidates(text)

                if candidates then

                    labelsFound += 1

                    local card =
                        findCard(
                            obj,
                            Weapons
                        )

                    local category,
                        itemName,
                        data =
                        resolveText(
                            obj,
                            card
                        )

                    if category
                        and itemName then

                        local value,
                            actualName =
                            findValue(
                                category,
                                itemName
                            )

                        if value then

                            local quantity =
                                getQuantity(
                                    card or obj
                                )

                            addResult(
                                category,
                                actualName or itemName,
                                quantity,
                                value,
                                card or obj
                            )

                            matched += 1

                            if DEBUG then

                                log(
                                    category ..
                                    " | " ..
                                    tostring(
                                        actualName
                                            or itemName
                                    ) ..
                                    " x" ..
                                    tostring(
                                        quantity
                                    ) ..
                                    " = " ..
                                    tostring(
                                        value *
                                        quantity
                                    )
                                )
                            end
                        end
                    end
                end
            end
        end
    end

    log(
        "ITEM NAME LABELS FOUND: " ..
        tostring(labelsFound)
    )

    log(
        "WEAPON ITEMS MATCHED: " ..
        tostring(matched)
    )
end

