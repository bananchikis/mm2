local function findPrice(name)
    if not name then return 0 end
    local n = name:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if PRICES[n] then return PRICES[n] end
    for key, price in pairs(PRICES) do
        if n:find(key, 1, true) then return price end
    end
    return 0
end

local inventory = {}

local function addItem(name)
    local price = findPrice(name)
    if price == 0 then return false, "Неизвестный предмет: " .. name end
    table.insert(inventory, {name = name, price = price})
    return true
end

local function removeItem(index)
    if inventory[index] then
        table.remove(inventory, index)
        return true
    end
    return false
end

local function getTotal()
    local t = 0
    for _, item in ipairs(inventory) do t = t + item.price end
    return t
end

