local function findSync(root)

    local exact =
        root:FindFirstChild(
            "Sync",
            true
        )

    if exact
        and exact:IsA("ModuleScript") then

        return exact
    end

    for _, obj in ipairs(
        root:GetDescendants()
    ) do

        if obj:IsA("ModuleScript") then

            local ok, result =
                pcall(require, obj)

            if ok
                and type(result) == "table"
                and type(result.Weapons) == "table" then

                return obj
            end
        end
    end

    return nil
end

