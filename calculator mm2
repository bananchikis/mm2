        return
    end

    log("------------------------------------------")
    log("SCANNING PETS")
    log("------------------------------------------")

    local objects =
        Pets:GetDescendants()

    log(
        "PETS OBJECTS: " ..
        tostring(#objects)
    )

    local matched = 0

    for _, obj in ipairs(objects) do

        if obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox") then

            local text =
                normalizeName(obj.Text)

            local pet =
                PetIndex[
                    lower(text)
                ]

            if pet then

                local card =
                    findCard(
                        obj,
                        Pets
                    )

                if card then

                    local quantity =
                        getQuantity(card)

                    addResult(
                        "Pets",
                        pet.Name,
                        quantity,
                        pet.Value,
                        card
                    )

                    matched += 1

                    if DEBUG then

                        log(
                            "Pets | " ..
                            pet.Name ..
                            " x" ..
                            tostring(quantity) ..
                            " = " ..
                            tostring(
                                pet.Value *
                                quantity
                            )
                        )
                    end
                end
            end
        end
    end

    log(
        "PETS MATCHED: " ..
        tostring(matched)
    )
end

