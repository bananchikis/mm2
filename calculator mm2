local function printCategory(category)

    print("------------------------------------------")

    print(
        category ..
        ": " ..
        tostring(
            Totals[category]
        ) ..
        " | Items: " ..
        tostring(
            ItemCounts[category]
        )
    )

    for itemName, data in pairs(
        Results[category]
    ) do

        print(
            "  " ..
            tostring(itemName) ..
            " x" ..
            tostring(data.Quantity) ..
            " = " ..
            tostring(
                data.Value *
                data.Quantity
            ) ..
            " (" ..
            tostring(data.Value) ..
            " each)"
        )
    end
end

printCategory("Godlies")
printCategory("Chromas")
printCategory("Ancients")
printCategory("Uniques")
printCategory("Pets")

print("------------------------------------------")

print(
    "Grand Total: " ..
    tostring(GrandTotal)
)

