local Totals = {
    Godlies = 0,
    Chromas = 0,
    Ancients = 0,
    Uniques = 0,
    Pets = 0
}

local ItemCounts = {
    Godlies = 0,
    Chromas = 0,
    Ancients = 0,
    Uniques = 0,
    Pets = 0
}

for category, items in pairs(
    Results
) do

    for itemName, data in pairs(
        items
    ) do

        Totals[category] +=
            data.Value *
            data.Quantity

        ItemCounts[category] +=
            data.Quantity
    end
end

local GrandTotal =
    Totals.Godlies +
    Totals.Chromas +
    Totals.Ancients +
    Totals.Uniques +
    Totals.Pets

